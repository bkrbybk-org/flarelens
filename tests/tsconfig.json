{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"jsx": "react-jsx",
		"types": ["@cloudflare/workers-types", "node"],
		"strict": true,
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"outDir": "../.tsbuild/tests",
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": ["**/*.ts"],
	"exclude": ["components"],
	"references": [{ "path": "../tsconfig.worker.json" }, { "path": "../web/tsconfig.json" }]
}
