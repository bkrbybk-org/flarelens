{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flarelens",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  // Serve only on the custom domain; no <name>.workers.dev URL
  "workers_dev": false,
  "routes": [
    {
      "pattern": "flarelens.example.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
